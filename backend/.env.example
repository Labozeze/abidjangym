APP_NAME=AbidjanGym
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Abidjan
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

API_VERSION=0.1.0

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données -------------------------------------------------------
# MySQL 8 sur Hostinger (CDC §3.1). SQLite est réservé aux tests (voir phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abidjangym
DB_USERNAME=abidjangym
DB_PASSWORD=valeur-fictive-a-remplacer
# DB_URL=  (laisser vide : une URL unique remplacerait les DB_* ci-dessus)

# --- Sessions et cache -----------------------------------------------------
# Fichiers uniquement : pas de Redis ni de Memcached sur l'hébergement mutualisé (CDC §3.2).
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
CACHE_PREFIX=abidjangym

# --- Files d'attente et diffusion ------------------------------------------
# sync : aucun worker persistant (CDC §3.2). Les tâches asynchrones passent par le
# planificateur Laravel lancé par cron : php artisan schedule:run chaque minute.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

# --- Emails ----------------------------------------------------------------
MAIL_MAILER=smtp
# Laisser MAIL_SCHEME vide pour un SMTP classique avec STARTTLS automatique (port 587).
MAIL_SCHEME=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=utilisateur-fictif
MAIL_PASSWORD=valeur-fictive-a-remplacer
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- CORS ------------------------------------------------------------------
# Origines autorisées : front public, backoffice et espace abonné (CDC §3.3).
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://abidjangym.com,https://app.abidjangym.com,https://member.abidjangym.com
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,X-XSRF-TOKEN,X-CSRF-TOKEN
CORS_MAX_AGE=86400

VITE_APP_NAME="${APP_NAME}"
