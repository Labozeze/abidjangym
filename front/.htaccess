# .htaccess du site public (front statique) — maintenu par Eric (Entité C)
# Copié à la racine web du front au déploiement. CDC §5.3, §6.1, §6.5.
# https://api-staging.abidjangym.com est remplacé au déploiement par l'origine de l'API (CSP).

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS obligatoire (CDC §6.1)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # En-têtes de sécurité (CDC §6.5)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # CSP du CDC §6.5, complétée par connect-src (appels à l'API) et des directives de durcissement
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: *.cloudflare.com; connect-src 'self' https://api-staging.abidjangym.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  Header always set X-Robots-Tag "noindex, nofollow"

  # Cache navigateur (CDC §5.3) : pages HTML toujours revalidées
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Les fichiers versionnés par Nuxt (/_nuxt/) ont leur propre .htaccess,
  # ajouté au déploiement : cache d'un an, immuable.
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
